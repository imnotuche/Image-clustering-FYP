/* ═══════════════════════════════════════════════
    GLOBAL
═══════════════════════════════════════════════ */
* {
    font-family: "DM Sans", "Segoe UI", sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow, #rootCanvas {
    background-color: #0D0D0D;
}

QWidget {
    background-color: transparent;
    color: #C8D0DC;
}

/* ═══════════════════════════════════════════════
    CARD SURFACE — shared by all four panels
═══════════════════════════════════════════════ */
#sidebarCard, #statsCard, #clusterCard, #gridCard {
    background-color: #1A1A1A;
    border-radius: 14px;
}

/* ═══════════════════════════════════════════════
SIDEBAR
═══════════════════════════════════════════════ */
#sidebarCard {
    min-width: 260px;
    max-width: 260px;
}

#appTitleAccent {
    font-size: 21px;
    font-weight: 800;
    color: #02c98d;
}
#appTitle {
    font-size: 21px;
    font-weight: 700;
    color: #FFFFFF;
}

#fieldLabel {
    color: #404858;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLineEdit {
    background-color: #111111;
    border: 1.5px solid #242424;
    border-radius: 9px;
    padding: 7px 10px;
    color: #C8D0DC;
}
QLineEdit:focus { border-color: #02c98d; }

#browseButton {
    background-color: #111111;
    border: 1.5px solid #242424;
    border-radius: 9px;
    padding: 7px 10px;
    color: #404858;
    font-weight: 600;
}
#browseButton:hover {
    border-color: #02c98d;
    color: #02c98d;
}

#runButton {
    background-color: #01362e;
    border: none;
    border-radius: 10px;
    color: #02c98d;
    font-weight: 700;
    font-size: 13px;
}
#runButton:hover  { background-color: #01503f; }
#runButton:pressed { background-color: #012920; }
#runButton:disabled {
    background-color: #141414;
    color: #1e3530;
}

#cancelButton {
    background-color: transparent;
    border: 1.5px solid #4a1a1a;
    border-radius: 9px;
    color: #d95555;
    font-weight: 600;
    font-size: 12px;
}
#cancelButton:hover {
    background-color: #1f0d0d;
    border-color: #d95555;
}

#exportButton {
    background-color: transparent;
    border: 1.5px solid #01362e;
    border-radius: 10px;
    color: #02c98d;
    font-weight: 700;
    font-size: 13px;
}
#exportButton:hover { background-color: #01362e; }
#exportButton:disabled {
    border-color: #1e1e1e;
    color: #1e3530;
}

QProgressBar {
    background-color: #111111;
    border: none;
    border-radius: 2px;
}
QProgressBar::chunk {
    background-color: #02c98d;
    border-radius: 2px;
}

#statusLabel {
    color: #404858;
    font-size: 11px;
}
#statusLabel[error="true"] { color: #d95555; }

QGroupBox#paramsGroup {
    border: 1.5px solid #242424;
    border-radius: 10px;
    margin-top: 10px;
    padding: 12px 8px 8px 8px;
    color: #404858;
    font-size: 11px;
    font-weight: 600;
}
QGroupBox#paramsGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #404858;
    background-color: #1A1A1A;
    letter-spacing: 0.5px;
}

QSpinBox {
    background-color: #111111;
    border: 1.5px solid #242424;
    border-radius: 8px;
    padding: 5px 6px;
    color: #C8D0DC;
}
QSpinBox:focus { border-color: #02c98d; }
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #1e1e1e;
    border: none;
    width: 16px;
    border-radius: 3px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #01362e;
}

/* ═══════════════════════════════════════════════
STATS BAR
═══════════════════════════════════════════════ */
#statLabel {
    color: #404858;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
}
#statValue {
    color: #02c98d;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

/* ═══════════════════════════════════════════════
CLUSTER CHIPS
═══════════════════════════════════════════════ */
#clusterChip {
    background-color: #111111;
    border: 1.5px solid #242424;
    border-radius: 10px;
    text-align: left;
    padding: 0;
}
#clusterChip:hover {
    border-color: #015040;
    background-color: #0d1a16;
}
#clusterChip:checked {
    background-color: #01362e;
    border-color: #02c98d;
}

#chipTitle {
    color: #C8D0DC;
    font-size: 12px;
    font-weight: 600;
}
#chipSub {
    color: #333d4d;
    font-size: 10px;
}

#clusterPlaceholder {
    color: #252525;
    font-size: 13px;
    font-weight: 500;
}

/* ═══════════════════════════════════════════════
IMAGE GRID
═══════════════════════════════════════════════ */
#gridHeader {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.3px;
}
#gridContainer { background-color: transparent; }

#thumbnailCard {
    background-color: #111111;
    border: 1.5px solid #242424;
    border-radius: 12px;
}
#thumbnailCard:hover {
    border-color: #02c98d;
    background-color: #0d1a16;
}

#confidenceBadge {
    color: #02c98d;
    font-size: 10px;
    font-weight: 600;
}

#emptyState {
    color: #252525;
    font-size: 14px;
    font-weight: 500;
}

/* ═══════════════════════════════════════════════
SCROLLBARS
═══════════════════════════════════════════════ */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #282828;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #02c98d; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 5px;
}
QScrollBar::handle:horizontal {
    background: #282828;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #02c98d; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ═══════════════════════════════════════════════
DIALOGS
═══════════════════════════════════════════════ */
QMessageBox { background-color: #1A1A1A; }
QMessageBox QLabel { color: #C8D0DC; }
QMessageBox QPushButton {
    background-color: #01362e;
    border: none;
    border-radius: 8px;
    color: #02c98d;
    font-weight: 700;
    padding: 6px 18px;
    min-width: 80px;
}
QMessageBox QPushButton:hover { background-color: #01503f; }